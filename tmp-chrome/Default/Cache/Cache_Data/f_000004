  }
  const dlClose = $('#dl-close');
  if (dlClose && !dlClose._bound) {
    dlClose._bound = true;
    dlClose.addEventListener('click', () => {
      dlCancelPending = true;
      if (dlTimer) { clearInterval(dlTimer); dlTimer = null; }
      closeDownloadModal();
      finishDownloadFlow($('#modal-apply'));
    });
  }
}

